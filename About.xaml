<Window x:Class="FSync.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSync"
        mc:Ignorable="d"
        Title="About" Height="230" Width="553">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Image Margin="10" Width="198" Source="Images/logo.png" Height="120" />
            <StackPanel Width="315">
                <TextBlock Margin="10" FontWeight="Bold">Automatic IED Log Fetcher version 0.0.1</TextBlock>
                <TextBlock TextWrapping="Wrap" Text="Automatic IED log fetcher is a software designed, developed and published by Engiprot LDA. All rights reserved." Margin="10" Width="280"/>
            </StackPanel>


        </StackPanel>
        <Button Margin="10" Padding="10,5,10,5" DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="close"/>
    </DockPanel>
</Window>
