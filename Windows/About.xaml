<Window x:Class="IEDCollector.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:IEDCollector.Properties"
        xmlns:local="clr-namespace:IEDCollector"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="About" Height="250" Width="553">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Image Margin="10" Width="198" Source="../Images/logo.png" Height="120" />
            <StackPanel Width="315">
                <TextBlock Margin="10" FontWeight="Bold" Text="{Binding VersionString}" />
                <TextBlock TextWrapping="Wrap" Margin="10" Width="280" Height="52"><Run Text="{x:Static p:Resources.rights}"/><LineBreak/><Run Language="en-gb" Text=" "/><LineBreak/><Run Language="en-gb" Text=" "/><LineBreak/><Run/><LineBreak/><Run/></TextBlock>
                <TextBlock TextWrapping="Wrap" HorizontalAlignment="Right" Margin="10,0,10,0">
                    <Run Text="{x:Static p:Resources.website}" />
                    <Hyperlink>https://www.engiprot.pt</Hyperlink>
                    <LineBreak />
                    <Run Text="{x:Static p:Resources.email}" />
                    <Hyperlink NavigateUri="mailto:geral@engiprot.pt">geral@engiprot.pt</Hyperlink>
                    <LineBreak />
                    <Run Text="{x:Static p:Resources.phone}" />
                    <Run Text=" +351 211 920 004" />
                </TextBlock>
            </StackPanel>


        </StackPanel>
        <Button Margin="10" Padding="10,5,10,5" DockPanel.Dock="Bottom" Content="{x:Static p:Resources.close}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="close"/>
    </DockPanel>
</Window>
