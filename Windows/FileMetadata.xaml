<Window x:Class="IEDCollector.FileMetadata"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IEDCollector"
        xmlns:p="clr-namespace:IEDCollector.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.file_metadata}" Height="292" Width="806">
    <DockPanel Margin="10,10,10,10">
        <Image DockPanel.Dock="Left" Height="160" Width="170" Source="/file-earmark-text-fill.png"/>
        <DockPanel DockPanel.Dock="Right" Width="547">
            <StackPanel DockPanel.Dock="Left" Width="244" Margin="10,5,10,5">
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.local_file}" FontSize="16" TextDecorations="Underline" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.path}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="localPathBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.last_modified}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="localModifiedBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.size}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="localSizeBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.hash_code}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="localHashCodeBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Width="250" Margin="20,0,0,0">
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.remote_file}" FontSize="16" TextDecorations="Underline" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.path}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="remotePathBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.last_modified}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="remoteModifiedBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.size}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="remoteSizeBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static p:Resources.hash_code}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2.5"/>
                <TextBlock x:Name="remoteHashCodeBox" TextWrapping="Wrap" Text="TextBlock" FontSize="14"/>
            </StackPanel>
        </DockPanel>
        
    </DockPanel>
</Window>
