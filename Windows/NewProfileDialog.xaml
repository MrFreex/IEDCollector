<Window x:Class="IEDCollector.NewProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IEDCollector"
        xmlns:p="clr-namespace:IEDCollector.Properties"
        Closing="Window_Closing"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.create_new_profile_window}" MinHeight="150" MinWidth="400">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10">
            <TextBlock Text="{x:Static p:Resources.profile_name}" />
            <TextBox x:Name="ProfileName" Margin="0,5,0,5" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Padding="5" VerticalAlignment="Center" Margin="10" x:Name="ok" Content="{x:Static p:Resources.submit}" Click="ok_Click" />
            <Button Padding="5" VerticalAlignment="Center" Margin="10" x:Name="cancel" Content="{x:Static p:Resources.cancel}" Click="cancel_Click" />
        </StackPanel>
    </DockPanel>
    
</Window>
