<Window x:Class="IEDCollector.Windows.LicenseRequest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IEDCollector.Windows"
        xmlns:p="clr-namespace:IEDCollector.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.license_request_window}" Height="171" Width="800" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="{x:Static p:Resources.full_name}" />
        <TextBox x:Name="fullName" Grid.Row="1" TextChanged="fullName_TextChanged" />
        <Label Grid.Row="2" Content="{x:Static p:Resources.location}" />
        <TextBox x:Name="location" Grid.Row="3" TextChanged="location_TextChanged" />
        <Button x:Name="req" Margin="0,10,0,10" Click="Button_Click" Grid.Row="4" Content="{x:Static p:Resources.request}" />
    </Grid>
</Window>
