<Window x:Class="IEDCollector.Configuration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:IEDCollector"
        xmlns:p="clr-namespace:IEDCollector.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.configuration}" Height="260" Width="583"
        ResizeMode="CanResizeWithGrip" SizeToContent="WidthAndHeight"
        >
        

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="119*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="228*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label HorizontalAlignment="Left" Grid.Row="0" Content="{x:Static p:Resources.log_level}" />
        <ComboBox VerticalAlignment="Center" Grid.ColumnSpan="3" x:Name="logLevels" Grid.Row="0" Grid.Column="1">

        </ComboBox>
        <Label VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1" Content="{x:Static p:Resources.log_files_kept}" />
        <TextBox Margin="5" Grid.Column="1" Grid.Row="1" x:Name="logFilesKept" VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="Auto" />
        <TextBlock Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Text="{x:Static p:Resources.files}" />
        <CheckBox Grid.Column="3" Grid.Row="1" x:Name="keepAllLogFiles" Margin="5" Content="{x:Static p:Resources.keep_all_files}" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="keepAllFiles_Checked" Unchecked="keepAllFiles_Checked"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Text="{x:Static p:Resources.software_data_location}" />
        <TextBox Grid.ColumnSpan="2" Grid.Row="2" Grid.Column="1" x:Name="dataLocation" Margin="5" />
        <Button Grid.Row="2" Grid.Column="3" Click="browseDataLocation" Content="{x:Static p:Resources.browse}" />
        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="startWithWindows" Content="{x:Static p:Resources.start_with_windows}" />
        <Button Click="save" Padding="10,0,10,0" HorizontalAlignment="Right" Margin="5" Grid.Row="5" Grid.Column="2" Content="{x:Static p:Resources.save}" />
        <Button Click="cancel" Margin="5" Grid.Row="5" Grid.Column="3" Content="{x:Static p:Resources.cancel}" />
    </Grid>
</Window>
