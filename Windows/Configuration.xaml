<Window x:Class="IEDCollector.Configuration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:IEDCollector"
        mc:Ignorable="d"
        Title="Configuration" Height="260" Width="583"
        ResizeMode="CanResizeWithGrip" SizeToContent="WidthAndHeight"
        >
        

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="119*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="228*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label HorizontalAlignment="Left" Grid.Row="0">Log Level</Label>
        <ComboBox VerticalAlignment="Center" Grid.ColumnSpan="3" x:Name="logLevels" Grid.Row="0" Grid.Column="1">

        </ComboBox>
        <Label VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1">Logs files kept</Label>
        <TextBox Margin="5" Grid.Column="1" Grid.Row="1" x:Name="logFilesKept" VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="Auto" />
        <TextBlock Grid.Column="2" Grid.Row="1" VerticalAlignment="Center">files</TextBlock>
        <CheckBox Grid.Column="3" Grid.Row="1" x:Name="keepAllLogFiles" Margin="5" Content="Keep all files" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="keepAllFiles_Checked" Unchecked="keepAllFiles_Checked"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2">Software data location</TextBlock>
        <TextBox Grid.ColumnSpan="2" Grid.Row="2" Grid.Column="1" x:Name="dataLocation" Margin="5" />
        <Button Grid.Row="2" Grid.Column="3" Click="browseDataLocation" Content="Browse" />
        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="startWithWindows" Content="Start with windows" />
        <Button Click="save" Padding="10,0,10,0" HorizontalAlignment="Right" Margin="5" Grid.Row="5" Grid.Column="2">Save</Button>
        <Button Click="cancel" Margin="5" Grid.Row="5" Grid.Column="3">Cancel</Button>
    </Grid>
</Window>
