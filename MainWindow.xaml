<Window x:Class="FSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSync"
        mc:Ignorable="d"
        Title="MainWindow" Height="478" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Login" />
                <MenuItem Header="Load" />
                <MenuItem Header="Save" />
            </MenuItem>
            <MenuItem Header="Options">
                <MenuItem Header="Configuration"/>
                <MenuItem Header="Preferences"/>
            </MenuItem>
            <MenuItem Header="About"/>
        </Menu>
        <Grid>
            <TabControl>
                <TabItem x:Name="viewerModeTab" Header="Viewer mode">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="151*"/>
                            <ColumnDefinition Width="643*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel LastChildFill="False" Grid.ColumnSpan="2">
                            <TreeView Width="147" Height="276" RenderTransformOrigin="0.5,0.505" VerticalAlignment="Top">
                                <TreeView.Background>
                                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.MenuColorKey}}"/>
                                </TreeView.Background>
                            </TreeView>
                            <Grid Height="274" Width="619" VerticalAlignment="Top">
                                <Button Content="Single Fetch" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                                <Button Content="Cyclic Fetch" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top"/>
                                <Button Content="Stop" HorizontalAlignment="Left" Margin="154,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.834,0.707"/>
                                <CheckBox Content="Resume when interrupted" HorizontalAlignment="Left" Margin="198,13,0,0" VerticalAlignment="Top" IsChecked="False"/>
                                <ProgressBar x:Name="Progress" Height="21" Margin="10,46,10,0" VerticalAlignment="Top" Value="50"/>
                                <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,72,10,0"/>
                            </Grid>
                        </DockPanel>
                        <TextBox x:Name="Logs0" Grid.ColumnSpan="2" Margin="0,278,0,0" />
                    </Grid>

                </TabItem>
                <TabItem Header="Configuration mode">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="151*"/>
                            <ColumnDefinition Width="643*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel LastChildFill="False" Grid.ColumnSpan="2">
                            <TreeView Width="147" Height="276" RenderTransformOrigin="0.5,0.505" VerticalAlignment="Top">
                                <TreeView.Background>
                                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.MenuColorKey}}"/>
                                </TreeView.Background>
                            </TreeView>
                            <Grid Height="274" Width="619" VerticalAlignment="Top">
                                
                            </Grid>
                        </DockPanel>
                        <TextBox x:Name="Logs1" Grid.ColumnSpan="2" Margin="0,278,0,0" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="Logs2" Header="User configuration mode">
                    <Grid/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
