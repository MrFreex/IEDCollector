<Window x:Class="FSync.NewProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSync"
        Closing="Window_Closing"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="Create a new profile" MinHeight="150" MinWidth="400">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10">
            <TextBlock>Profile Name</TextBlock>
            <TextBox x:Name="ProfileName" Margin="0,5,0,5" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Padding="5" VerticalAlignment="Center" Margin="10" x:Name="ok" Content="Create profile" Click="ok_Click" />
            <Button Padding="5" VerticalAlignment="Center" Margin="10" x:Name="cancel" Content="Cancel" Click="cancel_Click" />
        </StackPanel>
    </DockPanel>
    
</Window>
